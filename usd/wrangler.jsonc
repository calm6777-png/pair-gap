{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dollar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  // 화면 코드(src/app)를 usd/app.js로 묶은 뒤 배포합니다.
  "build": { "command": "npm run build" },
  // 저장소 전체(맨 앞 갭 차트 + usd/ 달러선물)를 GitHub Pages와 같은 구조로 함께 내보냅니다.
  // 소스·설정 파일은 ../.assetsignore 에서 뺍니다. 파일이 없는 경로(/api/*)만 Worker가 처리합니다.
  "assets": { "directory": ".." },
  "observability": { "enabled": true }
}
